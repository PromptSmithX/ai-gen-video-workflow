# POD Video Studio - development / test configuration.
# Copy to .env and fill in. NEVER commit .env.
# In the installed app the bridge API key is entered in Admin and stored with Windows DPAPI (safeStorage);
# MUSE_BRIDGE_API_KEY here is only a developer convenience and is never written to logs.

# mock | bridge   (mock = no network, safe default; bridge = approved local Muse bridge REST API)
PROVIDER_MODE=mock
# chat = full prompt sent verbatim via Muse4AI chat (<= 32000 chars); video = video job (<= 4000 chars)
MUSE_SUBMIT_MODE=chat
# Loopback port of the proxy the bundled Muse4AI runs for this machine (installed app only).
MUSE4AI_PROXY_PORT=

# Exact origin of the Muse product employees actually use (e.g. https://muse.ai). Required for compatibility gate.
MUSE_PLATFORM_ORIGIN=

# Local Muse bridge base URL. MUST be loopback (127.0.0.1 / localhost), e.g. http://127.0.0.1:47821
MUSE_BRIDGE_BASE_URL=

# Bearer API key issued by the local bridge.
MUSE_BRIDGE_API_KEY=

# Absolute path to the company-approved Prompt Master V2 markdown file. Empty = built-in PLACEHOLDER template.
PROMPT_MASTER_PATH=

# Root folder for the SKU media library (POD_VIDEO_LIBRARY). Empty = <Documents>/POD_VIDEO_LIBRARY
POD_LIBRARY_ROOT=

PROMPT_MAX_CHARS=20000
POLL_INTERVAL_MS=3000
POLL_MAX_INTERVAL_MS=15000
MAX_SOURCE_MB=15
MAX_SOURCE_PIXELS=50000000
MAX_VIDEO_MB=500
LOG_RETENTION_DAYS=30

# Comma-separated Windows usernames that get the Admin role. Empty = nobody is admin except in dev mode.
POD_ADMIN_USERS=

# Code signing (electron-builder). Leave empty for unsigned local builds.
CSC_LINK=
CSC_KEY_PASSWORD=
