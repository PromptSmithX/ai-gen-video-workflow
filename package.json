{
  "name": "pod-video-studio",
  "productName": "POD Video Studio",
  "version": "0.1.0",
  "private": true,
  "description": "POD Video Studio - generate product review videos from mockups via the approved Muse bridge",
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:muse4ai": "node vendor/muse4ai/build.mjs",
    "build:muse4ai:fast": "node vendor/muse4ai/build.mjs --skip-tests",
    "dist:dir": "node vendor/muse4ai/ensure.mjs && npm run build && electron-builder --win --dir --config electron-builder.yml",
    "dist": "node vendor/muse4ai/ensure.mjs && npm run build && electron-builder --win --config electron-builder.yml",
    "local-proxy": "node tools/local-proxy.mjs"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cross-env": "10.1.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
