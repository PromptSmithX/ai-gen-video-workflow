diff --git a/desktop/test/podBootstrap.test.ts b/desktop/test/podBootstrap.test.ts
new file mode 100644
index 0000000..9a82904
--- /dev/null
+++ b/desktop/test/podBootstrap.test.ts
@@ -0,0 +1,144 @@
+import fs from "node:fs";
+import http from "node:http";
+import net from "node:net";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { parseBootstrap, podLoginRoute, podProvision, POD_KEY_NAME, startLoopbackProxy, type PodTarget } from "../src/main/podBootstrap";
+
+function fakeTarget() {
+  const proxies: Array<{ id: string; host: string; port: number; health: string }> = [];
+  const accounts: Array<{ id: string; proxyId: string | null }> = [];
+  const keys: Array<{ id: string; name: string; revokedAt: number | null }> = [];
+  const calls = { apiEnable: 0, created: 0, revoked: [] as string[], imported: 0, tested: 0 };
+  const t: PodTarget = {
+    listProxies: () => proxies.map((p) => ({ ...p })),
+    importProxies: (text) => {
+      calls.imported++;
+      const [host, port] = text.split(":");
+      proxies.push({ id: `p${proxies.length + 1}`, host, port: Number(port), health: "unchecked" });
+    },
+    testProxy: async (id) => {
+      calls.tested++;
+      proxies.find((p) => p.id === id)!.health = "healthy";
+    },
+    listAccounts: () => accounts.map((a) => ({ ...a })),
+    addAccount: (input) => {
+      const p = proxies.find((x) => x.id === input.proxyId);
+      if (p?.health !== "healthy") throw new Error("proxy not healthy");
+      const a = { id: `a${accounts.length + 1}`, proxyId: input.proxyId };
+      accounts.push(a);
+      return a;
+    },
+    setAccountProxy: (id, pid) => {
+      accounts.find((a) => a.id === id)!.proxyId = pid;
+    },
+    apiEnable: async () => {
+      calls.apiEnable++;
+    },
+    listKeys: () => keys.map((k) => ({ ...k })),
+    revokeKey: (id) => {
+      calls.revoked.push(id);
+      keys.find((k) => k.id === id)!.revokedAt = 1;
+    },
+    createKey: (name) => {
+      calls.created++;
+      keys.push({ id: `k${keys.length + 1}`, name, revokedAt: null });
+      return { token: `msk_test_${keys.length}` };
+    },
+  };
+  return { t, proxies, accounts, keys, calls };
+}
+
+const noLog = () => undefined;
+
+function tmpKey(): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "podboot-"));
+  return path.join(dir, "muse.key");
+}
+
+describe("POD bootstrap", () => {
+  it("first run creates proxy, account and key once; a second run creates nothing", async () => {
+    const f = fakeTarget();
+    const keyOut = tmpKey();
+    const r1 = await podProvision({ keyOut, proxyPort: 8080, rotateKey: false }, f.t, noLog);
+    expect(r1.keyWritten).toBe(true);
+    expect(fs.readFileSync(keyOut, "utf8")).toBe("msk_test_1");
+    expect(f.proxies).toHaveLength(1);
+    expect(f.accounts).toHaveLength(1);
+    expect(f.keys.filter((k) => k.name === POD_KEY_NAME)).toHaveLength(1);
+
+    fs.unlinkSync(keyOut);
+    const r2 = await podProvision({ keyOut, proxyPort: 8080, rotateKey: false }, f.t, noLog);
+    expect(r2.keyWritten).toBe(false);
+    expect(fs.existsSync(keyOut)).toBe(false);
+    expect(f.calls.imported).toBe(1);
+    expect(f.accounts).toHaveLength(1);
+    expect(f.calls.created).toBe(1);
+  });
+
+  it("keeps an existing signed-in account and its proxy", async () => {
+    const f = fakeTarget();
+    f.proxies.push({ id: "old", host: "127.0.0.1", port: 8080, health: "healthy" });
+    f.accounts.push({ id: "may", proxyId: "old" });
+    const r = await podProvision({ keyOut: tmpKey(), proxyPort: 8080, rotateKey: false }, f.t, noLog);
+    expect(r.accountId).toBe("may");
+    expect(f.calls.imported).toBe(0);
+    expect(f.calls.tested).toBe(0);
+    expect(f.accounts).toEqual([{ id: "may", proxyId: "old" }]);
+  });
+
+  it("rotateKey revokes the old POD key and issues a new one", async () => {
+    const f = fakeTarget();
+    f.keys.push({ id: "k0", name: POD_KEY_NAME, revokedAt: null }, { id: "other", name: "Agent n8n", revokedAt: null });
+    const keyOut = tmpKey();
+    const r = await podProvision({ keyOut, proxyPort: 8080, rotateKey: true }, f.t, noLog);
+    expect(r.keyWritten).toBe(true);
+    expect(f.calls.revoked).toEqual(["k0"]);
+    expect(f.keys.find((k) => k.id === "other")!.revokedAt).toBeNull();
+  });
+
+  it("validates the bootstrap file", () => {
+    const keyOut = tmpKey();
+    expect(parseBootstrap(JSON.stringify({ keyOut, proxyPort: 8080 }))).toEqual({ keyOut, proxyPort: 8080, rotateKey: false });
+    expect(() => parseBootstrap(JSON.stringify({ keyOut: "relative.key", proxyPort: 8080 }))).toThrow();
+    expect(() => parseBootstrap(JSON.stringify({ keyOut: keyOut.replace(".key", ".txt"), proxyPort: 8080 }))).toThrow();
+    expect(() => parseBootstrap(JSON.stringify({ keyOut, proxyPort: 80 }))).toThrow();
+  });
+
+  it("login route prefers the account that needs a sign-in", () => {
+    expect(podLoginRoute([])).toBeNull();
+    expect(podLoginRoute([{ id: "a", state: "ready" }, { id: "b", state: "needs_login" }])).toBe("/accounts/b/login");
+    expect(podLoginRoute([{ id: "a", state: "ready" }])).toBe("/accounts/a/login");
+  });
+
+  it("loopback proxy forwards CONNECT and stays on 127.0.0.1", async () => {
+    const echo = net.createServer((s) => s.pipe(s));
+    await new Promise<void>((r) => echo.listen(0, "127.0.0.1", r));
+    const echoPort = (echo.address() as net.AddressInfo).port;
+    const probe = net.createServer();
+    await new Promise<void>((r) => probe.listen(0, "127.0.0.1", r));
+    const port = (probe.address() as net.AddressInfo).port;
+    await new Promise<void>((r) => probe.close(() => r()));
+
+    const server = (await startLoopbackProxy(port, noLog)) as http.Server;
+    expect((server.address() as net.AddressInfo).address).toBe("127.0.0.1");
+    const reply = await new Promise<string>((resolve, reject) => {
+      const req = http.request({ host: "127.0.0.1", port, method: "CONNECT", path: `127.0.0.1:${echoPort}` });
+      req.on("connect", (_res, socket) => {
+        socket.write("ping");
+        socket.once("data", (d) => {
+          resolve(String(d));
+          socket.destroy();
+        });
+      });
+      req.on("error", reject);
+      req.end();
+    });
+    expect(reply).toBe("ping");
+    // Port already taken: does not throw, reports null.
+    expect(await startLoopbackProxy(port, noLog)).toBeNull();
+    await new Promise<void>((r) => server.close(() => r()));
+    await new Promise<void>((r) => echo.close(() => r()));
+  });
+});
