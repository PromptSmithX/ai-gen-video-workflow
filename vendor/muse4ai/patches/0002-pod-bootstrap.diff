diff --git a/desktop/src/main/podBootstrap.ts b/desktop/src/main/podBootstrap.ts
new file mode 100644
index 0000000..f3c69d1
--- /dev/null
+++ b/desktop/src/main/podBootstrap.ts
@@ -0,0 +1,188 @@
+// POD Video Studio integration (local patch, not upstream).
+// POD launches this bundled copy with `--pod-bootstrap <file.json>`; this module then prepares everything a first
+// run needs so the user only signs in to Muse: the loopback proxy, the API on "this machine only", one account and
+// an API key for POD. Every step is idempotent: running it again creates nothing twice.
+import fs from "node:fs";
+import http from "node:http";
+import net from "node:net";
+import path from "node:path";
+
+export const POD_BUILD = true;
+export const POD_KEY_NAME = "POD Video Studio";
+const POD_ACCOUNT_ALIAS = "Muse";
+const PROXY_HOST = "127.0.0.1";
+
+export interface PodBootstrapFile {
+  /** Where to write a newly created API key (inside POD's own data folder). */
+  keyOut: string;
+  /** Loopback port of the forward proxy Muse uses for this machine's own connection. */
+  proxyPort: number;
+  /** POD has no working key: revoke the old POD key (token lost) and issue a new one. */
+  rotateKey: boolean;
+}
+
+export interface PodSettingsFile {
+  proxyPort: number;
+}
+
+type Log = (level: "info" | "warn" | "error", msg: string, data?: Record<string, unknown>) => void;
+
+export function readBootstrapArg(argv: readonly string[]): PodBootstrapFile | null {
+  const i = argv.indexOf("--pod-bootstrap");
+  if (i < 0 || !argv[i + 1]) return null;
+  return parseBootstrap(fs.readFileSync(argv[i + 1], "utf8"));
+}
+
+export function parseBootstrap(text: string): PodBootstrapFile {
+  const o = JSON.parse(text) as Record<string, unknown>;
+  const keyOut = typeof o.keyOut === "string" ? o.keyOut : "";
+  const proxyPort = Number(o.proxyPort);
+  if (!path.isAbsolute(keyOut) || !keyOut.endsWith(".key")) throw new Error("pod bootstrap: keyOut must be an absolute .key path");
+  if (!fs.existsSync(path.dirname(keyOut))) throw new Error("pod bootstrap: keyOut folder does not exist");
+  if (!Number.isInteger(proxyPort) || proxyPort < 1024 || proxyPort > 65535) throw new Error("pod bootstrap: invalid proxyPort");
+  return { keyOut, proxyPort, rotateKey: o.rotateKey === true };
+}
+
+const settingsPath = (roaming: string) => path.join(roaming, "pod.json");
+
+export function readPodSettings(roaming: string): PodSettingsFile | null {
+  try {
+    const o = JSON.parse(fs.readFileSync(settingsPath(roaming), "utf8")) as Record<string, unknown>;
+    const port = Number(o.proxyPort);
+    return Number.isInteger(port) && port >= 1024 && port <= 65535 ? { proxyPort: port } : null;
+  } catch {
+    return null;
+  }
+}
+
+export function writePodSettings(roaming: string, s: PodSettingsFile): void {
+  fs.writeFileSync(settingsPath(roaming), JSON.stringify(s));
+}
+
+// ------------------------------------------------------------------ loopback forward proxy
+const HOP_BY_HOP = new Set(["proxy-connection", "proxy-authorization", "proxy-authenticate", "connection", "keep-alive", "te", "trailer", "transfer-encoding", "upgrade"]);
+
+/** HTTP + CONNECT forward proxy on 127.0.0.1 only. Logs nothing about requests (no URLs, headers or bodies). */
+export function startLoopbackProxy(port: number, log: Log): Promise<http.Server | null> {
+  const server = http.createServer((req, res) => {
+    let target: URL;
+    try {
+      target = new URL(req.url ?? "");
+    } catch {
+      res.writeHead(400).end();
+      return;
+    }
+    if (target.protocol !== "http:") {
+      res.writeHead(400).end();
+      return;
+    }
+    const headers: http.OutgoingHttpHeaders = {};
+    for (const [k, v] of Object.entries(req.headers)) if (!HOP_BY_HOP.has(k.toLowerCase())) headers[k] = v;
+    const up = http.request({ hostname: target.hostname, port: target.port || 80, path: target.pathname + target.search, method: req.method, headers }, (u) => {
+      const out: http.OutgoingHttpHeaders = {};
+      for (const [k, v] of Object.entries(u.headers)) if (!HOP_BY_HOP.has(k.toLowerCase())) out[k] = v;
+      res.writeHead(u.statusCode ?? 502, out);
+      u.pipe(res);
+    });
+    up.on("error", () => {
+      if (!res.headersSent) res.writeHead(502);
+      res.end();
+    });
+    req.pipe(up);
+  });
+  server.on("connect", (req: http.IncomingMessage, client: net.Socket, head: Buffer) => {
+    const [host, portStr] = String(req.url).split(/:(?=\d+$)/);
+    const p = Number(portStr || 443);
+    if (!host || !Number.isInteger(p) || p < 1 || p > 65535) {
+      client.end("HTTP/1.1 400 Bad Request\r\n\r\n");
+      return;
+    }
+    const up = net.connect(p, host, () => {
+      client.write("HTTP/1.1 200 Connection Established\r\n\r\n");
+      if (head?.length) up.write(head);
+      up.pipe(client);
+      client.pipe(up);
+    });
+    up.on("error", () => {
+      if (!client.destroyed) client.end("HTTP/1.1 502 Bad Gateway\r\n\r\n");
+      up.destroy();
+    });
+    client.on("error", () => up.destroy());
+  });
+  server.on("clientError", (_e, socket) => {
+    if (!socket.destroyed) socket.end("HTTP/1.1 400 Bad Request\r\n\r\n");
+  });
+  return new Promise((resolve) => {
+    server.once("error", (e: NodeJS.ErrnoException) => {
+      // Another copy (or the old `npm run local-proxy`) already serves this port: Muse still reaches it.
+      log(e.code === "EADDRINUSE" ? "info" : "warn", "pod proxy not started", { port, code: e.code });
+      resolve(null);
+    });
+    server.listen(port, PROXY_HOST, () => {
+      log("info", "pod proxy listening", { port });
+      resolve(server);
+    });
+  });
+}
+
+// ------------------------------------------------------------------ provisioning
+/** The parts of Muse4AI the bootstrap drives (kept narrow so it can be tested without Electron). */
+export interface PodTarget {
+  listProxies(): Array<{ id: string; host: string; port: number; health: string }>;
+  importProxies(text: string): unknown;
+  testProxy(id: string): Promise<void>;
+  listAccounts(): Array<{ id: string; proxyId: string | null }>;
+  addAccount(input: { alias: string; avatar: number; proxyId: string }): { id: string };
+  setAccountProxy(id: string, proxyId: string): unknown;
+  apiEnable(): Promise<void>;
+  listKeys(): Array<{ id: string; name: string; revokedAt: number | null }>;
+  revokeKey(id: string): void;
+  createKey(name: string): { token: string };
+}
+
+export interface PodProvisionResult {
+  proxyId: string;
+  accountId: string;
+  keyWritten: boolean;
+}
+
+export async function podProvision(cfg: PodBootstrapFile, t: PodTarget, log: Log): Promise<PodProvisionResult> {
+  // 1. API on this machine only (default port 47821).
+  await t.apiEnable();
+
+  // 2. Proxy entry for the loopback proxy.
+  const find = () => t.listProxies().find((p) => p.host === PROXY_HOST && p.port === cfg.proxyPort);
+  if (!find()) t.importProxies(`${PROXY_HOST}:${cfg.proxyPort}`);
+  const proxy = find();
+  if (!proxy) throw new Error("pod bootstrap: proxy entry was not created");
+  if (proxy.health !== "healthy") await t.testProxy(proxy.id);
+
+  // 3. One account. An existing one is kept (already signed in); it moves to the loopback proxy only when its own
+  //    proxy is another loopback port that nothing serves anymore.
+  let accounts = t.listAccounts();
+  if (accounts.length === 0) {
+    t.addAccount({ alias: POD_ACCOUNT_ALIAS, avatar: 0, proxyId: proxy.id });
+    accounts = t.listAccounts();
+    log("info", "pod account added");
+  }
+  const account = accounts[0];
+  if (!account.proxyId) t.setAccountProxy(account.id, proxy.id);
+
+  // 4. API key for POD: only when POD asks for one, and only one active key with this name.
+  let keyWritten = false;
+  const active = t.listKeys().filter((k) => k.revokedAt === null && k.name === POD_KEY_NAME);
+  if (cfg.rotateKey || active.length === 0) {
+    for (const k of active) t.revokeKey(k.id);
+    const { token } = t.createKey(POD_KEY_NAME);
+    fs.writeFileSync(cfg.keyOut, token, { mode: 0o600 });
+    keyWritten = true;
+    log("info", "pod key issued");
+  }
+  return { proxyId: proxy.id, accountId: account.id, keyWritten };
+}
+
+/** `--pod-login`: route of the sign-in screen for the account that needs it (or the first one). */
+export function podLoginRoute(accounts: Array<{ id: string; state: string }>): string | null {
+  const a = accounts.find((x) => x.state === "needs_login") ?? accounts[0];
+  return a ? `/accounts/${a.id}/login` : null;
+}
